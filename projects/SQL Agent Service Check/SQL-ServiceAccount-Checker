param(
    [Parameter(Mandatory = $false)]
    [string]$ServiceAccount = "DOMAIN\svc_netbackup",

    [Parameter(Mandatory = $false)]
    [string]$SQLInstance = "localhost"
)

#=====================================================================
# NetBackup SQL Service Account Verification
#=====================================================================

$ErrorActionPreference = "Stop"
$Results = New-Object System.Collections.Generic.List[object]

function Add-Result {
    param(
        [string]$Category,
        [string]$Check,
        [ValidateSet("PASS", "FAIL", "WARN")]
        [string]$Status,
        [string]$Details
    )

    $Results.Add([PSCustomObject]@{
        Category = $Category
        Check    = $Check
        Status   = $Status
        Details  = $Details
    }) | Out-Null
}

function Test-Tool {
    param([string]$Name)
    return [bool](Get-Command -Name $Name -ErrorAction SilentlyContinue)
}

function Invoke-SqlText {
    param([string]$Query)

    $output = & sqlcmd -S $SQLInstance -E -b -W -h -1 -Q $Query 2>&1
    if ($LASTEXITCODE -ne 0) {
        throw ("sqlcmd failed. " + ($output -join " `n"))
    }

    return ($output | ForEach-Object { $_.ToString().Trim() } | Where-Object { $_ -ne "" })
}

function Invoke-SqlScalarInt {
    param([string]$Query)

    $lines = Invoke-SqlText -Query $Query
    if (-not $lines -or -not ($lines[0] -match "^-?\d+$")) {
        throw "Expected integer result from SQL query but got: $($lines -join '; ')"
    }

    return [int]$lines[0]
}

function Resolve-AccountSid {
    param([string]$Account)

    try {
        # If a SID is provided directly, return it unchanged.
        if ($Account -match '^S-\d-(\d+-){1,14}\d+$') {
            return $Account
        }

        $ntAccount = New-Object System.Security.Principal.NTAccount($Account)
        $sid = $ntAccount.Translate([System.Security.Principal.SecurityIdentifier])
        return $sid.Value
    }
    catch {
        return $null
    }
}

Write-Host "====================================="
Write-Host "NetBackup SQL Service Account Verification"
Write-Host "====================================="
Write-Host "Service Account: $ServiceAccount"
Write-Host "SQL Instance   : $SQLInstance"
Write-Host ""

if (-not (Test-Tool -Name "sqlcmd")) {
    Add-Result -Category "Prerequisite" -Check "sqlcmd installed" -Status "FAIL" -Details "sqlcmd not found in PATH. Install SQL Server command-line tools."
}
if (-not (Test-Tool -Name "secedit")) {
    Add-Result -Category "Prerequisite" -Check "secedit available" -Status "WARN" -Details "secedit not found; user rights checks will be skipped."
}

$escapedAccount = $ServiceAccount.Replace("'", "''")

#---------------------------------------------------------
# NetBackup services and runtime account
#---------------------------------------------------------
try {
    $nbServices = Get-CimInstance Win32_Service | Where-Object { $_.Name -match "NetBackup" }

    if (-not $nbServices) {
        Add-Result -Category "NetBackup" -Check "NetBackup services present" -Status "FAIL" -Details "No service with name matching 'NetBackup' was found."
    }
    else {
        $stopped = $nbServices | Where-Object { $_.State -ne "Running" }
        if ($stopped.Count -gt 0) {
            Add-Result -Category "NetBackup" -Check "NetBackup services running" -Status "WARN" -Details (("Stopped services: " + (($stopped | Select-Object -ExpandProperty Name) -join ", ")))
        }
        else {
            Add-Result -Category "NetBackup" -Check "NetBackup services running" -Status "PASS" -Details "All detected NetBackup services are running."
        }

        $matchingAccount = $nbServices | Where-Object { $_.StartName -ieq $ServiceAccount }
        if ($matchingAccount.Count -gt 0) {
            Add-Result -Category "NetBackup" -Check "Service logon uses target account" -Status "PASS" -Details "At least one NetBackup service runs as the target account."
        }
        else {
            Add-Result -Category "NetBackup" -Check "Service logon uses target account" -Status "WARN" -Details "No NetBackup service StartName matched the provided account."
        }
    }
}
catch {
    Add-Result -Category "NetBackup" -Check "NetBackup service inspection" -Status "FAIL" -Details $_.Exception.Message
}

#---------------------------------------------------------
# Local administrators check
#---------------------------------------------------------
try {
    $adminMembers = @()
    if (Get-Command Get-LocalGroupMember -ErrorAction SilentlyContinue) {
        $adminMembers = Get-LocalGroupMember -Group "Administrators" | Select-Object -ExpandProperty Name
    }
    else {
        $adminMembers = net localgroup administrators
    }

    $isLocalAdmin = $false
    foreach ($member in $adminMembers) {
        if ($member -and $member.ToString().Trim().ToLowerInvariant() -eq $ServiceAccount.ToLowerInvariant()) {
            $isLocalAdmin = $true
            break
        }
    }

    if ($isLocalAdmin) {
        Add-Result -Category "OS" -Check "Local Administrators membership" -Status "PASS" -Details "$ServiceAccount is in local Administrators."
    }
    else {
        Add-Result -Category "OS" -Check "Local Administrators membership" -Status "WARN" -Details "$ServiceAccount was not found in local Administrators."
    }
}
catch {
    Add-Result -Category "OS" -Check "Local Administrators membership" -Status "WARN" -Details "Unable to evaluate local admin membership: $($_.Exception.Message)"
}

#---------------------------------------------------------
# SQL connectivity and login checks
#---------------------------------------------------------
if (Test-Tool -Name "sqlcmd") {
    try {
        $serverIdentity = Invoke-SqlText -Query "SELECT @@SERVERNAME"
        Add-Result -Category "SQL" -Check "SQL connectivity" -Status "PASS" -Details ("Connected to server: " + ($serverIdentity -join " "))
    }
    catch {
        Add-Result -Category "SQL" -Check "SQL connectivity" -Status "FAIL" -Details $_.Exception.Message
    }

    try {
        $exists = Invoke-SqlScalarInt -Query "SELECT CASE WHEN EXISTS (SELECT 1 FROM sys.server_principals WHERE name = '$escapedAccount') THEN 1 ELSE 0 END"
        if ($exists -eq 1) {
            Add-Result -Category "SQL" -Check "SQL login exists" -Status "PASS" -Details "Login exists for $ServiceAccount."
        }
        else {
            Add-Result -Category "SQL" -Check "SQL login exists" -Status "FAIL" -Details "No SQL login exists for $ServiceAccount."
        }
    }
    catch {
        Add-Result -Category "SQL" -Check "SQL login exists" -Status "FAIL" -Details $_.Exception.Message
    }

    try {
        $isDisabled = Invoke-SqlScalarInt -Query "SELECT COALESCE((SELECT CAST(is_disabled AS int) FROM sys.server_principals WHERE name = '$escapedAccount'), -1)"
        if ($isDisabled -eq 0) {
            Add-Result -Category "SQL" -Check "SQL login enabled" -Status "PASS" -Details "Login is enabled."
        }
        elseif ($isDisabled -eq 1) {
            Add-Result -Category "SQL" -Check "SQL login enabled" -Status "FAIL" -Details "Login exists but is disabled."
        }
        else {
            Add-Result -Category "SQL" -Check "SQL login enabled" -Status "FAIL" -Details "Login could not be evaluated because it does not exist."
        }
    }
    catch {
        Add-Result -Category "SQL" -Check "SQL login enabled" -Status "FAIL" -Details $_.Exception.Message
    }

    try {
        $isSysAdmin = Invoke-SqlScalarInt -Query "SELECT ISNULL(IS_SRVROLEMEMBER('sysadmin', '$escapedAccount'), 0)"
        if ($isSysAdmin -eq 1) {
            Add-Result -Category "SQL" -Check "sysadmin role membership" -Status "PASS" -Details "Account is sysadmin (recommended for NetBackup SQL backup/restore operations)."
        }
        else {
            Add-Result -Category "SQL" -Check "sysadmin role membership" -Status "WARN" -Details "Account is not sysadmin; backup/restore may fail depending on SQL/NetBackup configuration."
        }
    }
    catch {
        Add-Result -Category "SQL" -Check "sysadmin role membership" -Status "FAIL" -Details $_.Exception.Message
    }

    try {
        $isDbCreator = Invoke-SqlScalarInt -Query "SELECT ISNULL(IS_SRVROLEMEMBER('dbcreator', '$escapedAccount'), 0)"
        if ($isDbCreator -eq 1) {
            Add-Result -Category "SQL" -Check "dbcreator role membership" -Status "PASS" -Details "Account is dbcreator (helps with restore to new databases)."
        }
        else {
            Add-Result -Category "SQL" -Check "dbcreator role membership" -Status "WARN" -Details "Account is not dbcreator. Restore to new databases may fail without equivalent rights."
        }
    }
    catch {
        Add-Result -Category "SQL" -Check "dbcreator role membership" -Status "FAIL" -Details $_.Exception.Message
    }

    try {
        $visibleDbCount = Invoke-SqlScalarInt -Query "SELECT COUNT(*) FROM sys.databases WHERE state = 0 AND HAS_DBACCESS(name) = 1"
        if ($visibleDbCount -gt 0) {
            Add-Result -Category "SQL" -Check "Database visibility" -Status "PASS" -Details "$visibleDbCount online database(s) visible to current SQL context."
        }
        else {
            Add-Result -Category "SQL" -Check "Database visibility" -Status "WARN" -Details "No online databases are visible to current SQL context."
        }
    }
    catch {
        Add-Result -Category "SQL" -Check "Database visibility" -Status "FAIL" -Details $_.Exception.Message
    }
}

#---------------------------------------------------------
# User rights assignment check (best effort)
#---------------------------------------------------------
if (Test-Tool -Name "secedit") {
    try {
        $tempFile = Join-Path $env:TEMP "secpol_export.inf"
        secedit /export /cfg $tempFile | Out-Null

        $serviceAccountSid = Resolve-AccountSid -Account $ServiceAccount
        $content = Get-Content -Path $tempFile -ErrorAction Stop
        $hasServiceLogonRight = $false
        foreach ($line in $content) {
            if ($line -like "SeServiceLogonRight=*") {
                $assignmentText = ($line -split "=", 2)[1]
                $entries = $assignmentText -split ","
                foreach ($entry in $entries) {
                    $normalizedEntry = $entry.Trim().TrimStart("*")

                    if (-not [string]::IsNullOrWhiteSpace($normalizedEntry) -and
                        ($normalizedEntry -ieq $ServiceAccount -or
                         ($serviceAccountSid -and $normalizedEntry -ieq $serviceAccountSid))) {
                        $hasServiceLogonRight = $true
                        break
                    }
                }
                break
            }
        }

        if ($hasServiceLogonRight) {
            if ($serviceAccountSid) {
                Add-Result -Category "OS" -Check "Log on as a service right" -Status "PASS" -Details "Account appears in SeServiceLogonRight (name or SID match)."
            }
            else {
                Add-Result -Category "OS" -Check "Log on as a service right" -Status "PASS" -Details "Account appears in SeServiceLogonRight (name match)."
            }
        }
        else {
            if ($serviceAccountSid) {
                Add-Result -Category "OS" -Check "Log on as a service right" -Status "WARN" -Details "Account was not found in SeServiceLogonRight export by name or SID."
            }
            else {
                Add-Result -Category "OS" -Check "Log on as a service right" -Status "WARN" -Details "Account string not found in SeServiceLogonRight export and SID could not be resolved for comparison."
            }
        }
    }
    catch {
        Add-Result -Category "OS" -Check "Log on as a service right" -Status "WARN" -Details "Unable to evaluate SeServiceLogonRight: $($_.Exception.Message)"
    }
}

#---------------------------------------------------------
# Summary and exit code
#---------------------------------------------------------
Write-Host ""
Write-Host "Verification Results"
Write-Host "--------------------"

foreach ($item in $Results) {
    switch ($item.Status) {
        "PASS" { Write-Host ("[PASS] " + $item.Check + " - " + $item.Details) -ForegroundColor Green }
        "WARN" { Write-Host ("[WARN] " + $item.Check + " - " + $item.Details) -ForegroundColor Yellow }
        "FAIL" { Write-Host ("[FAIL] " + $item.Check + " - " + $item.Details) -ForegroundColor Red }
    }
}

$failCount = ($Results | Where-Object { $_.Status -eq "FAIL" }).Count
$warnCount = ($Results | Where-Object { $_.Status -eq "WARN" }).Count
$passCount = ($Results | Where-Object { $_.Status -eq "PASS" }).Count

Write-Host ""
Write-Host "Summary: PASS=$passCount WARN=$warnCount FAIL=$failCount"

if ($failCount -gt 0) {
    Write-Host "Overall Result: NOT READY" -ForegroundColor Red
    exit 1
}
else {
    Write-Host "Overall Result: READY (with warnings if any)" -ForegroundColor Green
    exit 0
}